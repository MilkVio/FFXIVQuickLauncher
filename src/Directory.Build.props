<Project>
    <PropertyGroup Label="Target">
        <PlatformTarget>x64</PlatformTarget>
        <Platforms>x64</Platforms>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>preview</LangVersion>
        <NoWarn>1701;1702;CS0414;CS8601;CS8602;CS8604;CS8603;IDE1006;IDE0300;MSB3270;MSB324;CS0649;CA2211;CS8509;CS8625;MSB3305;CS8618;CS8600;CS8605;CS8620;NU1903</NoWarn>
        <SatelliteResourceLanguages>xxx</SatelliteResourceLanguages>
    </PropertyGroup>

    <PropertyGroup Label="Native Shims">
        <!-- Keep the normal local C# debug loop usable without a Rust toolchain; CI/release still builds native shims. -->
        <SkipNativeShims Condition="'$(SkipNativeShims)' == '' and '$(Configuration)' == 'Debug' and '$(CI)' != 'true'">true</SkipNativeShims>
        <SkipNativeShims Condition="'$(SkipNativeShims)' == ''">false</SkipNativeShims>
    </PropertyGroup>

</Project>
