<Window
    x:Class="XIVLauncher.Windows.QrLoginDeviceProfileChoiceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="机器码"
    Width="480"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    TextElement.FontWeight="Regular"
    TextElement.FontSize="14"
    Icon="pack://application:,,,/Resources/dalamud_icon.ico">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="MonitorAccount"
                                     Width="32"
                                     Height="32"
                                     Margin="0,0,14,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
            <TextBlock Text="选择本次二维码登录使用的机器码"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="46,0,0,24">
            <RadioButton x:Name="CreateIndependentRadioButton"
                         Margin="0,0,0,12"
                         GroupName="QrDeviceProfileChoice"
                         IsChecked="True"
                         Content="新建独立机器码" />
            <RadioButton x:Name="UseSharedRadioButton"
                         GroupName="QrDeviceProfileChoice"
                         Content="使用共享机器码" />

            <TextBlock x:Name="IndependentAccountHintTextBlock"
                       Margin="0,18,0,8"
                       Text="选择账户独立机器码"
                       FontWeight="SemiBold" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="IndependentAccountComboBox"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="IndependentAccountComboBox_OnSelectionChanged"
                          materialDesign:HintAssist.Hint="不选择" />
                <Button x:Name="ClearIndependentAccountButton"
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="8,0,0,0"
                        Padding="0"
                        ToolTip="清除选择"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Click="ClearIndependentAccountButton_OnClick">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                </Button>
            </Grid>
            <TextBlock x:Name="NoIndependentAccountTextBlock"
                       Margin="0,8,0,0"
                       Text="暂无启用独立机器码的账号"
                       Opacity="0.72"
                       FontSize="12"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100"
                    Margin="0,0,12,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="CancelButton_OnClick">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="取消" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Width="100"
                    IsDefault="True"
                    Click="ContinueButton_OnClick">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowRight" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="继续" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
