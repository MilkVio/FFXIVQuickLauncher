<components:ChromeWindow
    x:Class="XIVLauncher.Windows.ProxyEntryEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:XIVLauncher.Xaml.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加代理条目"
    Width="520"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    Icon="pack://application:,,,/Resources/dalamud_icon.ico"
    TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:TitleBar Grid.Row="0" />

        <Grid Grid.Row="1" Margin="32,16,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBox x:Name="NameTextBox"
                         Margin="0,0,0,16"
                         materialDesign:HintAssist.Hint="名称（可选，留空则使用主机:端口）"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                <TextBox x:Name="UrlTextBox"
                         Margin="0,0,0,4"
                         materialDesign:HintAssist.Hint="代理地址"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                <TextBlock Margin="0,0,0,4"
                           FontSize="12"
                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                           Text="格式: http://用户名:密码@主机:端口" />

                <TextBlock x:Name="ErrorTextBlock"
                           Margin="0,0,0,8"
                           FontSize="12"
                           Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                           Visibility="Collapsed" />

                <CheckBox x:Name="EnabledCheckBox"
                          Margin="0,4,0,0"
                          Content="启用此条目"
                          IsChecked="True" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,24,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button MinWidth="80"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"
                            Content="取消"
                            Style="{StaticResource MaterialDesignFlatButton}" />
                    <Button MinWidth="80"
                            Click="ConfirmButton_Click"
                            Content="确定"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</components:ChromeWindow>
